# Copie para .env e preencha. Nunca commite o .env.
# Telegram
BOT_TOKEN=
OWNER_ID=
CHAT_ID=

# opencode serve (o bot sobe um se não houver)
OPENCODE_DIR=/home/lumiko
OPENCODE_SERVER_PORT=4100
OPENCODE_SERVER_URL=http://127.0.0.1:4100
OPENCODE_SERVER_PASSWORD=

# Worker Python (FastAPI)
WORKER_URL=http://127.0.0.1:8090
WORKER_HOST=127.0.0.1
WORKER_PORT=8090

# Bot: dev = polling, prod = webhook (Bun.serve)
APP_ENV=dev
PORT=3000
WEBHOOK_DOMAIN=
DATA_DIR=./data

# Bateria
BATTERY_PATH=/sys/class/power_supply/battery
BATTERY_CHECK_INTERVAL=30
BATTERY_LOW_PCT=20

# /exec local (allowlist, sem shell)
EXEC_ALLOWLIST=
EXEC_TIMEOUT_MS=30000
EXEC_MAX_OUTPUT=8000
EXEC_CWD=
