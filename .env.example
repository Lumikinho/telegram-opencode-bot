# Get from @BotFather on Telegram
BOT_TOKEN=

# Your Telegram user ID (send /start to @userinfobot to find it)
OWNER_ID=

# Leave empty to auto-detect from first message
CHAT_ID=

# Working directory of the opencode sessions (where it can read/edit files)
OPENCODE_DIR=~/

# Port/URL of the opencode server (bot spawns one if none is running)
OPENCODE_SERVER_PORT=4970
OPENCODE_SERVER_URL=http://127.0.0.1:4970

# Password for the opencode v2 server (BasicAuth obrigatório no v2).
# Quando o bot sobe o servidor, ele injeta essa senha; se vazia, gera uma
# aleatória por boot. Para conectar num servidor já em execução, use a mesma.
OPENCODE_SERVER_PASSWORD=

# Battery monitor (reads /sys/class/power_supply/battery)
BATTERY_PATH=/sys/class/power_supply/battery
BATTERY_CHECK_INTERVAL=30
BATTERY_LOW_PCT=20